{
  "name": "haf-bot",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "HAF Bot Discord community management on Node.js and PostgreSQL",
  "main": "dist-node/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogersau/hafbot.git"
  },
  "scripts": {
    "dev": "docker compose --env-file .env.local up --build --wait",
    "build": "pnpm run build:admin && pnpm run build:landing && pnpm run build:node",
    "build:admin": "vite build -c vite.admin.config.ts && node scripts/admin-bundle/build-report.mjs && node scripts/admin-bundle/check-budgets.mjs && node scripts/emit-admin-static-assets.mjs && cp assets/favicon.ico dist-admin/favicon.ico && cp assets/logo.png dist-admin/logo.png && cp assets/banner.png dist-admin/banner.png && cp assets/_headers dist-admin/_headers",
    "admin:bundle-report": "node scripts/admin-bundle/build-report.mjs",
    "admin:bundle-check": "node scripts/admin-bundle/check-budgets.mjs",
    "qa:admin": "node scripts/admin-qa/run.mjs",
    "qa:admin:unit": "node --test test/admin-qa-*.test.mjs",
    "admin-contract:generate": "node scripts/admin-contract/generate.mjs",
    "admin-contract:check": "node scripts/admin-contract/generate.mjs --check",
    "build:landing": "vite build -c vite.landing.config.ts && node scripts/embed-landing-build.mjs && node --test scripts/check-landing-discovery.mjs",
    "build:node": "esbuild src/node/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-node/main.mjs && node esbuild.postgres.mjs",
    "build:node:e2e": "esbuild src/node/e2e-main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-e2e/main.mjs",
    "landing:dev": "pnpm run build:landing && node scripts/preview-landing.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck:admin": "tsc -p tsconfig.admin.json",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "build:test:types": "tsc -p tsconfig.tests.json",
    "build:test": "pnpm admin-contract:check && pnpm run build:test:types",
    "test:build": "pnpm run build:admin && pnpm run build:landing && node scripts/run-build-tests.mjs",
    "test:node": "pnpm run test:unit-integration",
    "test:unit": "pnpm run build:test:types && node scripts/run-node-tests.mjs --suite=unit",
    "test:integration": "pnpm run build:landing && pnpm run build:test:types && node scripts/run-node-tests.mjs --suite=integration",
    "test:unit-integration": "pnpm run build:landing && pnpm run build:test:types && node scripts/run-node-tests.mjs",
    "test:postgres": "pnpm run build:landing && pnpm run build:test:types && pnpm run test:postgres:prebuilt",
    "test:postgres:prebuilt": "node scripts/run-postgres-tests.mjs",
    "test:repeat": "pnpm run build:landing && node scripts/repeat-tests.mjs",
    "test:architecture": "pnpm run build:test:types && node scripts/run-architecture-tests.mjs",
    "container:smoke": "node scripts/container-smoke.mjs",
    "start:node": "node dist-node/main.mjs",
    "start": "pnpm run start:node",
    "postgres:migrate:check": "pnpm run build:node && node scripts/run-postgres-migrations.mjs --check",
    "postgres:migrate:apply": "pnpm run build:node && node scripts/run-postgres-migrations.mjs --apply",
    "migration:objects": "pnpm run build:node && node dist-node/object-migration.mjs",
    "postgres:jobs": "pnpm run build:node && node dist-node/postgres-jobs.mjs",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site && node --test scripts/check-public-docs.mjs",
    "docs:preview": "vitepress preview docs-site",
    "docs:screenshots": "pnpm run build:admin && node scripts/admin-docs/capture.mjs --update",
    "docs:screenshots:check": "pnpm run build:admin && node scripts/admin-docs/capture.mjs --check",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:admin",
    "typecheck:shared": "tsc --noEmit",
    "test": "node scripts/run-public-tests.mjs",
    "test:all": "node scripts/run-public-tests.mjs",
    "test:prebuilt": "node scripts/run-public-tests.mjs --prebuilt",
    "validate": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm docs:build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@azure/identity": "^4.14.0",
    "@azure/storage-blob": "^12.33.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@fontsource-variable/oxanium": "5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/cloudflare": "^10.68.0",
    "@sentry/node": "^11.11.0",
    "@skyra/discord-components-core": "^4.0.2",
    "@skyra/discord-components-react": "^4.0.2",
    "@tanstack/react-router": "^1.170.18",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "emoji-picker-react": "^4.19.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.86.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  },
  "homepage": "https://github.com/rogersau/hafbot#readme",
  "bugs": {
    "url": "https://github.com/rogersau/hafbot/issues"
  }
}
