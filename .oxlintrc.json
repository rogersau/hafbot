{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".worktrees/**",
    ".wrangler/**",
    "dist/**",
    "src/web/routeTree.gen.ts",
    ".tanstack/**",
    "dist-admin/**",
    "dist-node/**",
    "dist-tests/**",
    "node_modules/**"
  ],
  "jsPlugins": ["./oxlint-plugin-custom.mjs"],
  "rules": {
    "custom/no-use-effect": "warn",
    "custom/no-is-record": "warn"
  }
}
