# Default: build the reviewed checkout using compose.source.yaml. Public registry images are not yet published.
HAF_IMAGE=haf-bot:self-host
# Keep these two URL-safe password values identical for the bundled local database.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-value
DATABASE_URL=postgresql://haf:replace-with-a-long-url-safe-random-value@postgres:5432/haf?sslmode=disable
PG_ALLOW_INSECURE_DOCKER_NETWORK=true
HAF_BIND_PORT=8080
HAF_ROLE=all
# Independent operators use self-hosted core capabilities.
HAF_DEPLOYMENT_MODE=self-hosted
# Public identity and policy links for independent operators; ignored in hosted mode.
SELF_HOSTED_OPERATOR_NAME=
SELF_HOSTED_SUPPORT_URL=
SELF_HOSTED_TERMS_URL=
SELF_HOSTED_PRIVACY_URL=

HAF_PUBLIC_ORIGIN=https://bot.example.com
HAF_STATUS_TOKEN=replace-with-a-long-random-value
HAF_GATEWAY_ENABLED=false
HAF_JOBS_ENABLED=false
HAF_SCHEDULER_ENABLED=false
HAF_MAINTENANCE_MODE=true

# Activate Gateway, jobs and scheduler in stages after the independent-installation checks.
DISCORD_PUBLIC_KEY=replace-with-the-discord-application-public-key
DISCORD_BOT_TOKEN=replace-with-the-discord-bot-token
BOT_USER_ID=replace-with-the-discord-bot-user-id
DISCORD_APPLICATION_ID=replace-with-the-discord-application-id

# Pick one object provider. S3-compatible storage keeps the VPS host disposable.
S3_BUCKET_NAME=replace-me
S3_REGION=replace-me
S3_ENDPOINT=https://replace-me
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Application secrets remain ordinary environment names. Do not commit this file.
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=https://bot.example.com
DISCORD_OAUTH_CLIENT_ID=replace-me
DISCORD_OAUTH_CLIENT_SECRET=replace-me
COMPONENT_ID_SIGNING_SECRET=replace-with-a-long-random-value
EVIDENCE_MEDIA_SIGNING_SECRET=replace-with-a-long-random-value
# Base64 encoding of exactly 32 random bytes; retain existing keys during migration.
WEBHOOK_CREDENTIAL_KEY_V1=replace-with-a-base64-encoded-32-byte-key

# Optional operator-only slash commands: use your own private Guild and role.
HAF_ADMIN_GUILD_ID=
HAF_ADMIN_ROLE_ID=
COMMERCE_ENABLED=false

# Optional error reporting through the existing Sentry issue monitor.
SENTRY_DSN=

# Optional native Twitch alerts. Obtain both credentials from the Twitch app owner
# and provision them in the private production environment; never in Guild settings.
# Both must contain 20–128 letters/digits. Missing credentials disable Twitch feeds.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
