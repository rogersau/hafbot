# Copy to .env.e2e. Use a separate Discord test application and private test guild.
# Never use the production bot token or copy a production environment file.
DISCORD_BOT_TOKEN=replace-with-the-test-HAF-bot-token
DISCORD_PUBLIC_KEY=replace-with-the-test-application-public-key
DISCORD_APPLICATION_ID=replace-with-the-test-application-id
BOT_USER_ID=replace-with-the-test-HAF-bot-user-id

# Exactly one test guild and up to ten comma-separated tester bot user IDs.
# Do not include HAF's own bot ID. These IDs are not secrets.
HAF_E2E_GUILD_ID=replace-with-the-private-test-guild-id
HAF_E2E_BOT_USER_IDS=replace-with-the-tester-bot-user-id

# Optional: supply the auth secret and both OAuth values for staging dashboard login.
# Register http://localhost:8081/api/auth/callback/discord in the test application.
BETTER_AUTH_SECRET=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
COMPONENT_ID_SIGNING_SECRET=
