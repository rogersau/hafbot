# Copy to .env.local for pnpm dev. Never commit real credentials.
# Compose supplies local-only database and Discord placeholders by default.
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
BOT_USER_ID=
DISCORD_APPLICATION_ID=

# Optional: configure all four values to enable local dashboard login.
# Register http://localhost:8080/api/auth/callback/discord in the Discord app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# The default local stack leaves Gateway, jobs and scheduler disabled.
# Use infra/vps/.env.example for a production deployment.
